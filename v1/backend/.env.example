# Copy to .env and edit. Every setting is optional; defaults are in app/config.py.
REDIS_URL=redis://127.0.0.1:6379/0
STORAGE_ROOT=./storage
WORKER_COUNT=4

# cpu | cuda | auto
DEVICE=auto

# detectors: nudenet, weapon, blood, violence   (violence = blur the whole frame in violent scenes)
ANALYZER=nudenet,weapon,blood

CHUNK_SECONDS=4
ANALYSIS_FPS=3

# speech
WHISPER_MODEL=base
# WHISPER_LANGUAGE=hi
# PROFANITY_FILE=./my_extra_words.txt

# weapons: leave empty to auto-download the default YOLO weights, or point to your own .pt
# WEAPON_MODEL_PATH=./models/weapons.pt
