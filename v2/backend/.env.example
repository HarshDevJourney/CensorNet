# Copy to .env and edit. Every setting is optional; defaults are in app/config.py.
DATABASE_URL=postgresql+psycopg2://censor:censor@127.0.0.1:5432/censor
REDIS_URL=redis://127.0.0.1:6379/0
STORAGE_ROOT=./storage
WORKER_COUNT=2

# cpu | cuda | auto. RTX 5080: use cuda so a CPU-only PyTorch install fails instead of silently running on CPU.
DEVICE=cuda
CUDA_DEVICE=0
USE_FP16=true
# auto uses NVDEC + h264_nvenc when this ffmpeg was built with them
HWACCEL=auto
VIDEO_ENCODER=auto
NVENC_PRESET=p4
DETECT_BATCH=16

# detectors: nudenet, weapon, blood, violence   (violence = blur the whole frame in violent scenes)
ANALYZER=nudenet,weapon,blood,violence

CHUNK_SECONDS=4
ANALYSIS_FPS=3

# speech (float16 on the 5080)
WHISPER_MODEL=base
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=float16
# WHISPER_LANGUAGE=hi
# PROFANITY_FILE=./my_extra_words.txt

# weapons: leave empty to auto-download the default YOLO weights, or point to your own .pt
# WEAPON_MODEL_PATH=./models/weapons.pt
